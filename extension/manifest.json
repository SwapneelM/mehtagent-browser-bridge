{
  "manifest_version": 3,
  "name": "Local Browser Bridge",
  "version": "0.4.0",
  "description": "Let your local assistant act in this browser profile while you keep control.",
  "minimum_chrome_version": "118",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Local Browser Bridge"
  },
  "incognito": "not_allowed",
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
